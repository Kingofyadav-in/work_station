# ─────────────────────────────────────────────────────────────────────────────
# Jarvis (work_station) — Environment Variables Reference
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Generate secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
DASHBOARD_PASSWORD=change-this-password

# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=5050
STREAMLIT_PORT=8501

# ── AI Providers ──────────────────────────────────────────────────────────────
# Ollama is the local-first default and requires no API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=96

# ── Security ──────────────────────────────────────────────────────────────────
# Primary API key for authenticated Jarvis dashboard access.
# Generate: openssl rand -hex 32
JARVIS_API_KEY=
# Additional scoped tokens (JSON array). Leave blank if unused.
JARVIS_API_TOKENS=
# One-time token for the live-class endpoint.
LIVE_CLASS_TOKEN=
ALLOWED_ORIGIN=https://kingofyadav.in
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=https://kingofyadav.in,https://jarvis.kingofyadav.in,http://localhost:3000,http://127.0.0.1:3000
JARVIS_TRUSTED_PROXY_ADDRS=127.0.0.1,::1

# Bridge auth — Profile website → Jarvis proxy.
# Sent by Profile as: Authorization: Bearer <secret>
# Must match JARVIS_BRIDGE_SECRET in Profile's .env and Vercel env vars.
# Generate: openssl rand -hex 32
JARVIS_BRIDGE_SECRET=

# HI API key — gates /api/hi/* private dashboard endpoints.
# Must match HI_API_KEY in Profile's .env and Vercel env vars.
# Generate: openssl rand -hex 32
HI_API_KEY=

# ── Profile integration ───────────────────────────────────────────────────────
# Public URL of the Profile Vercel deployment.
JARVIS_PROFILE_API_URL=https://kingofyadav.in

# ── Public website chat ───────────────────────────────────────────────────────
# Set to 1 to allow unauthenticated visitors to use the chat widget.
JARVIS_PUBLIC_CHAT=0
JARVIS_PUBLIC_CHAT_RPM=12
JARVIS_PUBLIC_CHAT_TIMEOUT=60
JARVIS_PUBLIC_CHAT_WORKERS=1
# Set to 1 to enable fallback static reply when no AI provider is configured.
JARVIS_PUBLIC_CHAT_FALLBACK=1
# Absolute path to the Profile project (for site-knowledge embedding).
JARVIS_PUBLIC_SITE_ROOT=/home/youruser/dev/projects/Profile
# Override provider/model for public chat only. Leave blank to use global selector.
JARVIS_PUBLIC_CHAT_PROVIDER=
JARVIS_PUBLIC_CHAT_MODEL=

# ── Message bus ───────────────────────────────────────────────────────────────
# filesystem (default) | sqlite
JARVIS_BUS_BACKEND=filesystem

# ── Multi-Device Sync ─────────────────────────────────────────────────────────
# Share level: public (public memories only) | shared (tagged) | none (disabled)
JARVIS_SYNC_SHARE_LEVEL=public
# Seconds between sync cycles when running in --loop mode.
JARVIS_SYNC_INTERVAL=300
# Per-request timeout (seconds) for peer HTTP calls.
JARVIS_SYNC_TIMEOUT=10
# Secret validated via X-Jarvis-Peer-Secret header on push-memories requests.
# Must match the peer_secret value used when registering a peer.
# Generate: openssl rand -hex 32
JARVIS_SYNC_SECRET=

# ── Voice Intelligence ────────────────────────────────────────────────────────
# Backend: google (online, default) | vosk (offline) | whisper (offline)
JARVIS_VOICE_BACKEND=google
JARVIS_VOICE_LANG=en-IN
# Path to a downloaded Vosk model directory (only needed when backend=vosk).
JARVIS_VOSK_MODEL=models/vosk-model
# Whisper model size: tiny | base | small | medium | large (only when backend=whisper).
JARVIS_WHISPER_MODEL=base

# ── Automation ────────────────────────────────────────────────────────────────
# Set to 1 to log automation actions without executing them.
AUTOMATION_DRY_RUN=0
# When set, all outbound webhook payloads are signed with sha256=<hex>.
AUTOMATION_WEBHOOK_SECRET=
