APP_ENV=development
DASHBOARD_PASSWORD=change-this-dashboard-password

# API server
API_HOST=127.0.0.1
API_PORT=5050
STREAMLIT_PORT=8501

# AI providers — configure the provider(s) you want to use.
# Ollama is the local-first default and requires no API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Tune context/output size to keep local inference within the site response timeout.
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=96

# Security — required before exposing the API beyond localhost
JARVIS_API_KEY=
JARVIS_API_TOKENS=                    # JSON list of scoped tokens, e.g. ["tok_abc","tok_def"]
LIVE_CLASS_TOKEN=
ALLOWED_ORIGIN=https://kingofyadav.in
# Shared secret for the Profile website → Jarvis proxy bridge.
# Must match JARVIS_BRIDGE_SECRET in Profile's Vercel env vars.
# When set, /api/jarvis-chat accepts requests from the Profile proxy
# even when JARVIS_PUBLIC_CHAT=0.
JARVIS_BRIDGE_SECRET=
JARVIS_TRUSTED_PROXY_ADDRS=127.0.0.1,::1

# Message bus backend
JARVIS_BUS_BACKEND=filesystem         # filesystem | sqlite

# OpenAI custom base URL (optional — leave blank for api.openai.com)
OPENAI_BASE_URL=

# Profile website integration
# Set JARVIS_PROFILE_API_URL to the Profile Vercel deployment URL so Jarvis can
# read site knowledge and push public state updates.
JARVIS_PROFILE_API_URL=https://kingofyadav.in
# HI_API_KEY must match the HI_API_KEY set in Profile's Vercel env vars.
# It gates the /api/hi/* private dashboard endpoints.
HI_API_KEY=

# Public website chat (disabled by default; set to 1 to enable)
JARVIS_PUBLIC_CHAT=0
JARVIS_PUBLIC_CHAT_RPM=12
JARVIS_PUBLIC_CHAT_TIMEOUT=60
JARVIS_PUBLIC_CHAT_WORKERS=1
JARVIS_PUBLIC_SITE_ROOT=/home/kingofyadav/Profile
# Override provider/model for public chat only. Leave blank to use global AI selector.
JARVIS_PUBLIC_CHAT_PROVIDER=
JARVIS_PUBLIC_CHAT_MODEL=

# Multi-Device Sync (Phase 5)
# Share level: public (only public memories) | shared (tagged shared) | none (disabled)
JARVIS_SYNC_SHARE_LEVEL=public
# Seconds between sync agent cycles when running in --loop mode
JARVIS_SYNC_INTERVAL=300
# Per-request timeout for peer HTTP calls
JARVIS_SYNC_TIMEOUT=10
# Shared secret for authenticating peer push-memories requests.
# When set, push-memories requires X-Jarvis-Peer-Secret header to match.
# Set the same value as peer_secret when registering a peer via add sync peer <url>.
JARVIS_SYNC_SECRET=

# Voice Intelligence (Phase 3)
# Backend: google (default, online) | vosk (offline, requires model) | whisper (offline, requires model)
JARVIS_VOICE_BACKEND=google
JARVIS_VOICE_LANG=en-US
# Path to a downloaded Vosk language model directory (e.g. vosk-model-en-us-0.22)
JARVIS_VOSK_MODEL=models/vosk-model
# Whisper model size: tiny | base | small | medium | large (larger = slower + more accurate)
JARVIS_WHISPER_MODEL=base
