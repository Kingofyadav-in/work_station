# ══════════════════════════════════════════════════════════════════════════════
# Jarvis Platform — Environment Variables Reference
# Version: 4.2  |  Platform: Linux  |  Python: 3.12
# ══════════════════════════════════════════════════════════════════════════════
#
# USAGE
#   cp .env.example .env
#   nano .env           # fill in required values
#   bash scripts/start_all.sh
#
# SECURITY RULES
#   • NEVER commit .env — it is listed in .gitignore
#   • Rotate any key that appears in a log, terminal output, or commit history
#   • Generate secrets with: openssl rand -hex 32
#   • Minimum password length: 16 characters
#   • Remove API keys for providers you are not using
#
# NOTATION
#   [REQUIRED]  — must be set; service will fail or lock without it
#   [OPTIONAL]  — safe to leave blank; feature is disabled or uses a default
#   [GENERATE]  — run the shown command and paste the output
#   default=X   — value used when the variable is left blank
#
# ══════════════════════════════════════════════════════════════════════════════


# ── Runtime ───────────────────────────────────────────────────────────────────
# [REQUIRED] Environment mode.
# development → relaxed auth, verbose errors
# production  → DASHBOARD_PASSWORD enforced, secrets required
APP_ENV=development

# [REQUIRED in production] Dashboard login password.
# The dashboard locks and refuses to render if this is blank in production.
# [GENERATE] openssl rand -hex 16
DASHBOARD_PASSWORD=change-this-password


# ── Database ──────────────────────────────────────────────────────────────────
# [OPTIONAL] PostgreSQL connection string.
# Used by Railway-hosted deployments. Leave blank for local SQLite-only setup.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:port/dbname


# ── API Server ────────────────────────────────────────────────────────────────
# [OPTIONAL] Network binding for the FastAPI control plane.
# Keep 127.0.0.1 (loopback) — Nginx is the public edge. Never use 0.0.0.0
# unless you have explicit firewall and proxy rules in place.
# default=127.0.0.1
API_HOST=127.0.0.1

# [OPTIONAL] Port for the FastAPI control plane.
# default=5050
API_PORT=5050

# [OPTIONAL] Port for the Streamlit dashboard.
# default=8501
STREAMLIT_PORT=8501


# ── AI Providers ──────────────────────────────────────────────────────────────
# Jarvis is local-first. Ollama runs on your machine with no API key required.
# OpenAI and Anthropic are optional online fallbacks.
# Active provider and model are stored in logs/ai_model_config.json and can
# be switched live from the dashboard sidebar without restarting.

# ·· Ollama (local, default) ··················································
# [REQUIRED for local AI] Ollama server URL.
# Install: https://ollama.com  |  Pull model: ollama pull llama3:latest
# default=http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# [OPTIONAL] Model name as it appears in `ollama list`.
# default=llama3:latest
OLLAMA_MODEL=llama3.2:3b

# [OPTIONAL] Context window size in tokens.
# Smaller = faster responses and lower RAM usage. Recommended: 1024–4096.
# default=2048
OLLAMA_NUM_CTX=2048

# [OPTIONAL] Maximum tokens to generate per response.
# default=96
OLLAMA_NUM_PREDICT=96

# ·· OpenAI (online fallback) ··················································
# [OPTIONAL] Leave blank to disable OpenAI entirely.
OPENAI_API_KEY=

# [OPTIONAL] OpenAI model. Must be available on your account tier.
# default=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# [OPTIONAL] Custom base URL for OpenAI-compatible API (e.g., LM Studio, vLLM).
# Leave blank to use the official OpenAI endpoint.
OPENAI_BASE_URL=

# ·· Anthropic (online fallback) ················································
# [OPTIONAL] Leave blank to disable Anthropic entirely.
ANTHROPIC_API_KEY=

# [OPTIONAL] Anthropic model.
# default=claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6


# ── Security ──────────────────────────────────────────────────────────────────
# When JARVIS_API_KEY is blank, private API endpoints only accept requests
# from localhost (127.0.0.1 / ::1). Set a key to allow external callers.

# [OPTIONAL] Primary API key for full authenticated access.
# Pass as: Authorization: Bearer <key>  or  X-Api-Key: <key>
# [GENERATE] openssl rand -hex 32
JARVIS_API_KEY=

# [OPTIONAL] Scoped token JSON array (overrides JARVIS_API_KEY for fine-grained
# access). Leave blank and use logs/api_tokens.json instead for easier editing.
# Format: [{"name":"dashboard","token":"...","scopes":["read","command"],"rpm":60}]
JARVIS_API_TOKENS=

# [OPTIONAL] One-time token for POST /api/live-class state updates.
# [GENERATE] openssl rand -hex 24
LIVE_CLASS_TOKEN=

# [REQUIRED in production] Single allowed CORS origin for the API.
# Used by the primary CORS middleware. Must exactly match the browser origin.
ALLOWED_ORIGIN=https://kingofyadav.in

# [OPTIONAL] Comma-separated list of additional CORS origins.
# Include localhost ports you use during development.
ALLOWED_ORIGINS=https://kingofyadav.in,https://jarvis.kingofyadav.in,http://localhost:3000,http://127.0.0.1:3000

# [OPTIONAL] Comma-separated IPs treated as trusted reverse proxies.
# Used to extract the real client IP from X-Forwarded-For headers.
# default=127.0.0.1,::1
JARVIS_TRUSTED_PROXY_ADDRS=127.0.0.1,::1

# [OPTIONAL] Secret validated via Authorization: Bearer header on Jarvis bridge
# requests from the Profile/website app.
# Must match JARVIS_BRIDGE_SECRET in Profile's .env and Vercel env vars.
# [GENERATE] openssl rand -hex 32
JARVIS_BRIDGE_SECRET=

# [OPTIONAL] API key that gates /api/hi/* private dashboard endpoints.
# Must match HI_API_KEY in Profile's .env and Vercel env vars.
# [GENERATE] openssl rand -hex 32
HI_API_KEY=


# ── Profile Integration ───────────────────────────────────────────────────────
# [OPTIONAL] Public URL of the Profile (website) Vercel deployment.
# Used by bridge outbound calls. Leave blank if not using Profile integration.
JARVIS_PROFILE_API_URL=https://kingofyadav.in


# ── Public Website Chat ───────────────────────────────────────────────────────
# The public chat widget lets unauthenticated website visitors chat with Jarvis.
# It is fully isolated — it cannot execute commands or read private state.

# [OPTIONAL] Set to 1 to enable the /api/jarvis-chat endpoint and JS widget.
# default=0 (disabled)
JARVIS_PUBLIC_CHAT=0

# [OPTIONAL] Max requests per visitor per minute for the chat endpoint.
# default=12
JARVIS_PUBLIC_CHAT_RPM=12

# [OPTIONAL] Seconds before the AI provider call is abandoned.
# Set to 60 when using local Ollama — it can be slow on first load.
# default=60
JARVIS_PUBLIC_CHAT_TIMEOUT=60

# [OPTIONAL] Number of parallel workers for public chat requests.
# Set to 1 to serialize requests to a local Ollama instance.
# default=1
JARVIS_PUBLIC_CHAT_WORKERS=1

# [OPTIONAL] Return a static fallback reply when no AI provider responds.
# Prevents blank or error responses from reaching website visitors.
# default=1
JARVIS_PUBLIC_CHAT_FALLBACK=1

# [OPTIONAL] Absolute path to the Profile/website project directory.
# Used to load local knowledge files for public chat context.
JARVIS_PUBLIC_SITE_ROOT=/home/youruser/dev/projects/Profile

# [OPTIONAL] Pin public chat to a specific AI provider.
# Values: ollama | openai | anthropic | blank (follow global selector)
JARVIS_PUBLIC_CHAT_PROVIDER=

# [OPTIONAL] Pin public chat to a specific model (within the above provider).
# Leave blank to follow the model set in the global selector.
JARVIS_PUBLIC_CHAT_MODEL=


# ── Message Bus ───────────────────────────────────────────────────────────────
# The bus carries requests between Jarvis and the Kingofyadav HI listener.
# Filesystem is the default and requires no extra dependencies.

# [OPTIONAL] Bus backend.
# filesystem (default) — atomic file writes in shared/bus/
# sqlite               — WAL-backed SQLite at shared/bus/bus.db (better for bursts)
JARVIS_BUS_BACKEND=filesystem


# ── Multi-Device Sync ─────────────────────────────────────────────────────────
# Phase 5 feature — synchronise memories across trusted Jarvis peers.

# [OPTIONAL] What to share with peers.
# public  — public-tagged memories only (default, recommended)
# shared  — memories with the "shared" tag
# none    — disable sync entirely
JARVIS_SYNC_SHARE_LEVEL=public

# [OPTIONAL] Seconds between sync cycles in --loop mode.
# default=300
JARVIS_SYNC_INTERVAL=300

# [OPTIONAL] Per-request HTTP timeout (seconds) for peer calls.
# default=10
JARVIS_SYNC_TIMEOUT=10

# [OPTIONAL] Peer authentication secret validated via X-Jarvis-Peer-Secret header.
# Must match the peer_secret value used when registering the peer.
# [GENERATE] openssl rand -hex 32
JARVIS_SYNC_SECRET=


# ── Voice Intelligence ────────────────────────────────────────────────────────
# Controls the speech recognition backend used by voice_input.py and the
# Conversation page in the dashboard.

# [OPTIONAL] Speech recognition backend.
# google  — online, no setup required (default)
# vosk    — offline, requires a downloaded model at JARVIS_VOSK_MODEL
# whisper — offline, requires openai-whisper installed
JARVIS_VOICE_BACKEND=google

# [OPTIONAL] BCP-47 language tag for recognition.
# Examples: en-US | en-IN | hi-IN | fr-FR
# default=en-IN
JARVIS_VOICE_LANG=en-IN

# [OPTIONAL] Absolute path to a downloaded Vosk model directory.
# Only required when JARVIS_VOICE_BACKEND=vosk.
# Download models: https://alphacephei.com/vosk/models
JARVIS_VOSK_MODEL=models/vosk-model

# [OPTIONAL] Whisper model size. Larger = more accurate but slower.
# Values: tiny | base | small | medium | large
# Only required when JARVIS_VOICE_BACKEND=whisper.
# default=base
JARVIS_WHISPER_MODEL=base


# ── Automation ────────────────────────────────────────────────────────────────
# Phase 4 automation daemon settings. Rules are defined in automation/rules.json.

# [OPTIONAL] Set to 1 to evaluate rules without executing actions (dry-run mode).
# Useful for testing new rules before enabling them in production.
# default=0
AUTOMATION_DRY_RUN=0

# [OPTIONAL] HMAC secret for signing outbound webhook payloads.
# Signature is sent as X-Jarvis-Signature: sha256=<hex>.
# Leave blank to disable payload signing.
# [GENERATE] openssl rand -hex 32
AUTOMATION_WEBHOOK_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
# END OF REFERENCE
# After filling in real values, run:  bash scripts/doctor.sh
# ══════════════════════════════════════════════════════════════════════════════
